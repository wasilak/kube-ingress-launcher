{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kube Ingress Launcher",
  "version": "0.2.4",
  "identifier": "foo.otteryak.kube-ingress-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kube Ingress Launcher",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Kubernetes Ingress Launcher",
    "longDescription": "A desktop launcher for quickly searching and opening Kubernetes ingress resources",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": null,
      "infoPlist": "./Info.plist"
    }
  }
}
